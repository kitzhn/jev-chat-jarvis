<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="com.jev.probe.IntegrationSetupActivity"
            android:exported="${integrationControlsExported}" />
        <receiver
            android:name="com.jev.probe.IntegrationCommandReceiver"
            android:exported="${integrationControlsExported}">
            <intent-filter>
                <action android:name="io.github.kitzhn.jevultimate.debug.FILL_FOR_TEST" />
            </intent-filter>
        </receiver>
        <activity
            android:name="com.jev.probe.KnowledgeActivity"
            android:exported="${integrationControlsExported}"
            tools:replace="android:exported" />
        <activity
            android:name="com.jev.probe.SettingsActivity"
            android:exported="${integrationControlsExported}"
            tools:replace="android:exported" />
        <activity
            android:name="com.jev.probe.ApiUsageActivity"
            android:exported="${integrationControlsExported}"
            tools:replace="android:exported" />
        <activity
            android:name="com.jev.probe.OverlayDemoActivity"
            android:exported="${integrationControlsExported}" />
        <activity
            android:name="com.jev.probe.WeChatOcrDemoActivity"
            android:exported="${integrationControlsExported}" />
        <activity
            android:name="com.jev.probe.AdaptiveModelDemoActivity"
            android:exported="${integrationControlsExported}" />
        <activity
            android:name="com.jev.probe.V23FeatureDemoActivity"
            android:exported="${integrationControlsExported}" />
    </application>
</manifest>
